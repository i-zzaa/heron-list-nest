# Aplicação
PORT=3000
JWT_PRIVATE_KEY=change-me

# Banco de dados
DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco
# Usada pela sessão (express-session) — antes reusava JWT_PRIVATE_KEY com um
# fallback hardcoded ('dev-secret-key') quando não definida; agora é
# obrigatória (cai para JWT_PRIVATE_KEY só se esta não existir, nunca para
# um valor fixo).
SESSION_PRIVATE_KEY=change-me-too
EXPIRES_IN_SECONDS=3600

# Amil
AMIL_LOTE_GUIAS_URL=
AMIL_STATUS_PROTOCOLO_URL=
AMIL_SOAP_ACTION_LOTE=
AMIL_SOAP_ACTION_STATUS=
AMIL_TIMEOUT_MS=30000
AMIL_MOCK_MODE=true

# Financeiro (opcionais — se não definidas, mantém o valor que já estava
# hardcoded no código: 0.9 por km, 50 por sessão de devolutiva)
FINANCEIRO_VALOR_POR_KM=0.9
FINANCEIRO_VALOR_SESSAO_DEVOLUTIVA=50
