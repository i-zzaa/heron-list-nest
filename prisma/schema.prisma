generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider             = "mysql"
  url                  = env("DATABASE_URL")
  relationMode          = "foreignKeys"
}

model Convenio {
  id       Int        @id @default(autoincrement())
  nome     String
  Paciente Paciente[]
}

model Paciente {
  id                Int    @id @default(autoincrement())
  nome              String
  telefone          String
  responsavel       String
  dataNascimento    String
  convenioId        Int
  statusPacienteCod String
  tipoSessaoId      Int
  statusId          Int?
  carteirinha       String @default("")

  emAtendimento Boolean @default(false)
  disabled      Boolean @default(false)

  // Data de emissão (não a de vencimento — calculada a partir dela, ver
  // PacienteService.calcularVencimentoDocumento): Plano Terapêutico vence
  // em 6 meses, Laudo Médico em 12 meses. Opcionais porque nem todo
  // paciente tem os dois cadastrados ainda (ex.: pacientes já existentes
  // antes desse campo existir).
  dataEmissaoPlanoTerapeutico String?
  dataEmissaoLaudoMedico      String?

  vaga           Vaga?
  calendario     Calendario[]
  statusPaciente StatusPaciente @relation(fields: [statusPacienteCod], references: [cod])
  convenio       Convenio?      @relation(fields: [convenioId], references: [id])
  tipoSessao     TipoSessao?    @relation(fields: [tipoSessaoId], references: [id])
  status         Status?        @relation(fields: [statusId], references: [id])

  createdAt         DateTime            @default(now())
  updateAt          DateTime            @default(now())
  pacienteHistorico PacienteHistorico[]
  Baixa             Baixa[]
  Sessao            Sessao[]
  Protocolo         Protocolo[]
  AtividadeSessao   AtividadeSessao[]
  Pei               Pei[]
  Portage           Portage[]
  VBMappResultado   VBMappResultado[]
  guiaAmil          GuiaAmil[]
}

model StatusPaciente {
  id       Int        @id @default(autoincrement())
  nome     String
  cod      String     @unique @default("therapy")
  Paciente Paciente[]
}

model Vaga {
  id          Int     @id @default(autoincrement())
  pacienteId  Int     @unique
  dataContato String
  periodoId   Int
  observacao  String?
  naFila      Boolean @default(true)

  dataSaiuFila   String?
  devolutiva     Boolean @default(false)
  dataDevolutiva String?
  dataVoltouAba  String?
  diff           String?
  dataRetorno    String?

  periodo        Periodo?              @relation(fields: [periodoId], references: [id])
  paciente       Paciente?             @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  especialidades VagaOnEspecialidade[]

  createdAt DateTime @default(now())
}

model VagaOnEspecialidade {
  agendado        Boolean @default(false)
  dataAgendado    String?
  vagaId          Int
  especialidadeId Int

  valor Decimal @default(200.00) @db.Decimal(10, 2)
  km    Decimal @default(0.00) @db.Decimal(10, 2)

  especialidade Especialidade @relation(fields: [especialidadeId], references: [id])
  vaga          Vaga          @relation(fields: [vagaId], references: [id], onDelete: Cascade)

  @@id([vagaId, especialidadeId])
}

model Periodo {
  id     Int     @id @default(autoincrement())
  nome   String
  // Item 6 dos "pontos menores" (heron-list-web): opção default marcada
  // no próprio cadastro, em vez do front supor qual id é o padrão
  // (PatientForm.tsx tinha PERIODO.integral/STATUS.padrao/
  // TIPO_SESSAO.terapeuta hardcoded). Mesmo padrão em Status/TipoSessao.
  padrao Boolean @default(false)
  vaga   Vaga[]
}

model Especialidade {
  id         Int                   @id @default(autoincrement())
  nome       String                @unique
  // Sigla estável pra lógica do front (cor de tag/chip etc.) — nome é
  // texto livre editável, não serve como chave de comparação. Gerada a
  // partir do nome quando não vier no create/update (ver
  // EspecialidadeService.resolveCodigo), mas pode ser sobrescrita.
  codigo     String                @unique
  cor        String                @default("#000000")
  // Igual ao padrão de Localidade/Funcao: desativar em vez de excluir
  // (a exclusão física exige que nada esteja vinculado — ver
  // assertEntidadeNaoEstaEmUso em EspecialidadeService.delete).
  ativo      Boolean               @default(true)
  Funcao     Funcao[]
  calendario Calendario[]
  terapeuta  Terapeuta[]
  vagas      VagaOnEspecialidade[]
}

model Status {
  id       Int        @id @default(autoincrement())
  nome     String
  padrao   Boolean    @default(false)
  paciente Paciente[]
}

model TipoSessao {
  id       Int        @id @default(autoincrement())
  nome     String
  padrao   Boolean    @default(false)
  paciente Paciente[]
}

// Cadastro simples (só nome), igual Periodo/Status/TipoSessao — vinculado
// a Baixa (link opcional pra identificar/rastrear o atendimento por
// ticket de origem, ex.: sistema de chamados externo).
model Ticket {
  id    Int     @id @default(autoincrement())
  nome  String
  // Mesmo padrão de Especialidade/Localidade/Funcao: desativar em vez de
  // excluir (a listagem paginada só mostra ativo=true — ver
  // TicketService.getAll/dropdown/search).
  ativo Boolean @default(true)
  baixa Baixa[]
}

model Usuario {
  id               Int     @id @default(autoincrement())
  nome             String
  login            String  @unique
  senha            String
  ativo            Boolean @default(true)
  perfilId         Int
  grupoPermissaoId Int?
  // Setado toda vez que a senha é definida por outra pessoa (reset de
  // admin) ou na criação do usuário — o login continua funcionando, mas
  // até o usuário trocar a própria senha (PUT /usuarios/reset-senha*),
  // ações que exigem tag de permissão ficam bloqueadas (ver PermissionsGuard).
  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())

  perfil          Perfil            @relation(fields: [perfilId], references: [id])
  grupo           GrupoPermissao?   @relation(fields: [grupoPermissaoId], references: [id])
  calendario      Calendario[]
  terapeuta       Terapeuta?
  Baixa           Baixa[]
  VBMappResultado VBMappResultado[]
}

model Perfil {
  id      Int       @id @default(autoincrement())
  nome    String
  usuario Usuario[]
}

model Localidade {
  id         Int          @id @default(autoincrement())
  casa       String
  sala       String
  ativo      Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  calendario Calendario[]
  Baixa      Baixa[]
}

model StatusEventos {
  id         Int          @id @default(autoincrement())
  nome       String       @unique
  // Código estável pra lógica do front (cor/categoria do status) — nome
  // é texto livre editável, não serve como chave de comparação. Gerado
  // a partir do nome quando não vier no create/update (ver
  // StatusEventoService.resolveCodigo), mas pode ser sobrescrito.
  codigo     String       @unique
  // Item 4 do pedido do front (heron-list-web): cor pronta pra badge,
  // mesmo padrão de Especialidade.cor — sem isso o front mantinha 3
  // paletas fixas em paralelo, tentando adivinhar a cor a partir do nome.
  cor        String       @default("#94a3b8")
  cobrar     Boolean      @default(false)
  // Indica se esse status representa um atendimento realizado (ex.:
  // "Atendido") — mesmo padrão de cobrar, cadastrável pelo front.
  atender    Boolean      @default(false)
  ativo      Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  calendario Calendario[]
  Baixa      Baixa[]
}

model Frequencia {
  id         Int          @id @default(autoincrement())
  nome       String
  ativo      Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  calendario Calendario[]
}

model Modalidade {
  id         Int          @id @default(autoincrement())
  nome       String
  ativo      Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  calendario Calendario[]
}

model Intervalo {
  id         Int          @id @default(autoincrement())
  nome       String
  ativo      Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  calendario Calendario[]
}

model Funcao {
  id              Int      @id @default(autoincrement())
  nome            String
  especialidadeId Int
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  especialidade Especialidade @relation(fields: [especialidadeId], references: [id])
  calendario    Calendario[]

  terapeutas TerapeutaOnFuncao[]

  @@unique([nome, especialidadeId])
}

model Terapeuta {
  usuarioId       Int      @unique
  especialidadeId Int
  fazDevolutiva   Boolean? @default(true)
  cargaHoraria    Json?

  usuario       Usuario?       @relation(fields: [usuarioId], references: [id])
  especialidade Especialidade? @relation(fields: [especialidadeId], references: [id])
  calendario    Calendario[]

  funcoes         TerapeutaOnFuncao[]
  Baixa           Baixa[]
  Protocolo       Protocolo[]
  AtividadeSessao AtividadeSessao[]
  Pei             Pei[]
}

model TerapeutaOnFuncao {
  terapeutaId Int
  funcaoId    Int
  comissao    Decimal? @default(80.00) @db.Decimal(10, 2)
  tipo        String?  @default("Fixo")

  terapeuta Terapeuta? @relation(fields: [terapeutaId], references: [usuarioId], onDelete: Cascade)
  funcao    Funcao?    @relation(fields: [funcaoId], references: [id], onDelete: Cascade)

  @@id([terapeutaId, funcaoId])
}

model Calendario {
  id      Int    @id @default(autoincrement())
  groupId String

  dataInicio     String
  dataFim        String
  start          String
  end            String?
  diasFrequencia String
  exdate         String?
  isExterno      Boolean @default(false)
  isChildren     Boolean @default(false)
  km             Decimal @default(0.00) @db.Decimal(10, 2)

  // Snapshot financeiro: valor/comissão/tarifas vigentes gravados no momento
  // em que o evento foi criado ou teve paciente/especialidade/terapeuta/
  // função alterados — para que um reajuste de preço feito depois não altere
  // relatórios de período já fechado (ver FinanceiroService, que passa a
  // preferir esses campos em vez de sempre reler o cadastro atual). Nullable
  // porque eventos criados antes desta coluna existir foram populados
  // retroativamente com o melhor valor disponível (o atual, na migration),
  // mas o campo continua opcional por segurança.
  valorSessaoSnapshot           Decimal? @db.Decimal(10, 2)
  comissaoSnapshot              Decimal? @db.Decimal(10, 2)
  tipoComissaoSnapshot          String?
  valorPorKmSnapshot            Decimal? @db.Decimal(10, 2)
  valorSessaoDevolutivaSnapshot Decimal? @db.Decimal(10, 2)

  ciclo           String
  observacao      String?
  pacienteId      Int
  modalidadeId    Int
  especialidadeId Int
  terapeutaId     Int
  funcaoId        Int
  // Nullable a partir de isExterno: atendimento externo não tem localidade
  // cadastrada — km e localExternoDescricao passam a ser obrigatórios no
  // lugar dela (ver validateEvento/validateAgendamentoVinculos).
  localidadeId          Int?
  localExternoDescricao String?
  statusEventosId       Int
  frequenciaId    Int
  intervaloId     Int
  usuarioId       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  terapeuta     Terapeuta     @relation(fields: [terapeutaId], references: [usuarioId])
  paciente      Paciente      @relation(fields: [pacienteId], references: [id])
  modalidade    Modalidade    @relation(fields: [modalidadeId], references: [id])
  especialidade Especialidade @relation(fields: [especialidadeId], references: [id])
  funcao        Funcao        @relation(fields: [funcaoId], references: [id])
  localidade    Localidade?   @relation(fields: [localidadeId], references: [id])
  statusEventos StatusEventos @relation(fields: [statusEventosId], references: [id])
  frequencia    Frequencia    @relation(fields: [frequenciaId], references: [id])
  intervalo     Intervalo     @relation(fields: [intervaloId], references: [id])
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])

  Baixa           Baixa[]
  Sessao          Sessao[]
  AtividadeSessao AtividadeSessao?

  @@index([terapeutaId, start])
  @@index([pacienteId])
  @@index([groupId])
  // Toda listagem de agenda (getFilter/getRange) e os endpoints do
  // dashboard filtram por essas duas colunas (ver buildDateRangeWhere) —
  // sem índice até aqui porque a tabela era pequena o bastante pra não
  // importar; deixado pronto antes de virar um problema real.
  @@index([dataInicio, dataFim])
}

model Permissao {
  id        Int    @id @default(autoincrement())
  cod       String
  descricao String

  GrupoPermissaoOnPermissao GrupoPermissaoOnPermissao[]
}

model GrupoPermissao {
  id         Int                         @id @default(autoincrement())
  nome       String
  permissoes GrupoPermissaoOnPermissao[]
  Usuario    Usuario[]
}

model GrupoPermissaoOnPermissao {
  grupoPermissaoId Int @map("grupoPermissaoId")
  permissaoId      Int @map("permissaoId")

  grupoPermissao GrupoPermissao @relation(fields: [grupoPermissaoId], references: [id])
  permissao      Permissao      @relation(fields: [permissaoId], references: [id])

  @@id([grupoPermissaoId, permissaoId])
  @@map("GrupoPermissaoOnPermissao")
}

model PacienteHistorico {
  id         Int  @id @default(autoincrement())
  pacienteId Int
  historico  Json

  paciente Paciente @relation(fields: [pacienteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

// Auditoria genérica (Paciente/Calendario por enquanto — ver
// HistoricoService) — tabela única reaproveitável em vez de uma por
// entidade, pra manter simples. Decisões de peso, todas deliberadas:
// - grava só o que mudou (`antes`/`depois` só com os campos diferentes
//   numa edição), não o registro inteiro duas vezes;
// - `usuarioLogin` é string direto, não FK pra Usuario — evita 1 consulta
//   extra por escrita só pra resolver id (o controller já tem o login do
//   JWT de graça) e continua legível sem precisar de JOIN pra exibir;
// - índice cobre exatamente a consulta de leitura (`entidade+entidadeId`,
//   mais recente primeiro) — nunca é lida/filtrada em telas de listagem
//   normais, só quando alguém abre o histórico de um registro específico.
model HistoricoAlteracao {
  id           Int      @id @default(autoincrement())
  entidade     String
  entidadeId   Int
  acao         String // criacao | edicao | exclusao
  antes        Json?
  depois       Json?
  usuarioLogin String?
  createdAt    DateTime @default(now())

  @@index([entidade, entidadeId, createdAt])
}

model Baixa {
  id              Int     @id @default(autoincrement())
  pacienteId      Int
  terapeutaId     Int
  statusEventosId Int
  eventoId        Int?
  usuarioId       Int?
  // Nullable pelo mesmo motivo de Calendario.localidadeId: baixa gerada a
  // partir de um evento externo (isExterno) não tem localidade — nesse caso
  // localExternoDescricao é gravado no lugar (snapshot do evento de origem).
  localidadeId          Int?
  localExternoDescricao String?
  baixa                 Boolean @default(false)
  dataEvento            String
  // Vínculo opcional com o chamado/ticket de origem (ex.: sistema externo
  // de suporte) — editável direto na listagem de Baixa, sem passar pelo
  // fluxo de confirmação de baixa (ver BaixaService.update).
  ticketId              Int?

  paciente   Paciente      @relation(fields: [pacienteId], references: [id])
  terapeuta  Terapeuta     @relation(fields: [terapeutaId], references: [usuarioId])
  status     StatusEventos @relation(fields: [statusEventosId], references: [id])
  usuario    Usuario?      @relation(fields: [usuarioId], references: [id])
  localidade Localidade?   @relation(fields: [localidadeId], references: [id])
  evento     Calendario?   @relation(fields: [eventoId], references: [id])
  ticket     Ticket?       @relation(fields: [ticketId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([eventoId])
  @@index([usuarioId])
  @@index([dataEvento])
}

// Auditoria de exclusão de Baixa (R16): a tabela já existia via migration
// solta (20260805123719_baixa_exclusao_log) sem estar mapeada aqui nem usada
// pelo código — conectada agora em BaixaService.delete(). Sem relation
// declarada de propósito (baixaId não é FK: o registro de Baixa já foi
// apagado quando este log é gravado, então não há nada para referenciar).
model BaixaExclusaoLog {
  id        Int      @id @default(autoincrement())
  baixaId   Int
  motivo    String
  usuarioId Int?
  snapshot  Json
  createdAt DateTime @default(now())
}

model Programa {
  id            Int     @id @default(autoincrement())
  nome          String
  ativo         Boolean @default(true)
  tipoProtocolo Json    @default("[2,3]") // Array de inteiros com valor padrão [3]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Pei               Pei[]
  VBMappAtividades  VBMappAtividades[]
  PortageAtividades PortageAtividades[]
}

model Protocolo {
  id           Int  @id @default(autoincrement())
  protocolo    Json
  protocoloSet Json
  terapeutaId  Int?
  pacienteId   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  terapeuta Terapeuta? @relation(fields: [terapeutaId], references: [usuarioId])
  paciente  Paciente   @relation(fields: [pacienteId], references: [id])
}

model Sessao {
  id           Int    @id @default(autoincrement())
  resumo       String
  calendarioId Int?
  sessao       Json?
  pacienteId   Int

  maintenance             Json?
  selectedMaintenanceKeys Json?

  portage             Json?
  selectedPortageKeys Json?

  vbmapp             Json?
  selectedVBMappKeys Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  paciente Paciente    @relation(fields: [pacienteId], references: [id])
  evento   Calendario? @relation(fields: [calendarioId], references: [id])

  guiaAmil GuiaAmil[]
}

model GuiaAmil {
  id                Int       @id @default(autoincrement())
  numeroGuia        String
  tipoGuia          String
  pacienteId        Int
  sessaoId          Int?
  prestadorId       Int?
  status            String    @default("RASCUNHO")
  dadosGuia         Json?
  valorTotal        Decimal?  @db.Decimal(10, 2)
  prontoParaEnvioEm DateTime?
  enviadoEm         DateTime?
  processadoEm      DateTime?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt
  loteId            Int?

  paciente      Paciente            @relation(fields: [pacienteId], references: [id])
  sessao        Sessao?             @relation(fields: [sessaoId], references: [id])
  loteGuiaItems LoteGuiaItem[]
  historico     GuiaAmilHistorico[]
}

model LoteGuia {
  id              Int       @id @default(autoincrement())
  numeroLote      String?
  origem          String    @default("MANUAL")
  status          String    @default("CRIADO")
  protocolo       String?
  idempotencyKey  String?   @unique
  quantidadeGuias Int       @default(0)
  xmlEnvio        String?   @db.Text
  xmlRetorno      String?   @db.Text
  enviadoEm       DateTime?
  consultadoEm    DateTime?
  processadoEm    DateTime?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  itens      LoteGuiaItem[]
  transacoes TransacaoAmil[]
}

model LoteGuiaItem {
  id               Int      @id @default(autoincrement())
  loteId           Int
  guiaId           Int
  status           String   @default("AGUARDANDO_LOTE")
  codigoRetorno    String?
  mensagemRetorno  String?
  valorApresentado Decimal? @db.Decimal(10, 2)
  valorProcessado  Decimal? @db.Decimal(10, 2)
  valorGlosado     Decimal? @db.Decimal(10, 2)

  lote LoteGuia @relation(fields: [loteId], references: [id])
  guia GuiaAmil @relation(fields: [guiaId], references: [id])
}

model GuiaAmilHistorico {
  id             Int      @id @default(autoincrement())
  guiaId         Int
  loteId         Int?
  statusAnterior String?
  statusNovo     String?
  acao           String?
  mensagem       String?
  detalhes       Json?
  usuarioId      Int?
  criadoEm       DateTime @default(now())

  guia GuiaAmil @relation(fields: [guiaId], references: [id])
}

model TransacaoAmil {
  id           Int      @id @default(autoincrement())
  loteId       Int
  tipo         String
  statusHttp   Int?
  sucesso      Boolean  @default(false)
  tentativa    Int      @default(1)
  duracaoMs    Int?
  codigoErro   String?
  mensagemErro String?
  xmlEnvio     String?  @db.Text
  xmlRetorno   String?  @db.Text
  criadoEm     DateTime @default(now())

  lote LoteGuia @relation(fields: [loteId], references: [id])
}

model AtividadeSessao {
  id           Int    @id @default(autoincrement())
  calendarioId Int    @unique
  peisIds      String

  atividades   Json?
  selectedKeys Json?

  maintenance             Json?
  selectedMaintenanceKeys Json?

  portage             Json?
  selectedPortageKeys Json?

  vbmapp             Json?
  selectedVbMappKeys Json?

  terapeutaId Int
  pacienteId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  terapeuta Terapeuta  @relation(fields: [terapeutaId], references: [usuarioId])
  paciente  Paciente   @relation(fields: [pacienteId], references: [id])
  evento    Calendario @relation(fields: [calendarioId], references: [id])
}

model Pei {
  id                   Int  @id @default(autoincrement())
  procedimentoEnsinoId Int
  pacienteId           Int
  programaId           Int
  terapeutaId          Int?

  estimuloDiscriminativo     String
  resposta                   String
  estimuloReforcadorPositivo String
  metas                      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  paciente  Paciente   @relation(fields: [pacienteId], references: [id])
  terapeuta Terapeuta? @relation(fields: [terapeutaId], references: [usuarioId])
  programa  Programa   @relation(fields: [programaId], references: [id])
}

model Portage {
  id                  Int       @id @default(autoincrement())
  portage             Json?
  pacienteId          Int
  respostaPortage     Json?
  respostaPortageDate DateTime?

  estimuloDiscriminativo     String?
  resposta                   String?
  estimuloReforcadorPositivo String?

  createdAt DateTime? @default(now()) // Campo opcional com valor padrão
  updatedAt DateTime? @updatedAt // Atualiza automaticamente ao modificar

  // Relations
  paciente Paciente @relation(fields: [pacienteId], references: [id])
}

model VBMappResultado {
  id             Int    @id @default(autoincrement())
  respostaSessao String
  vbmappId       Int
  pacienteId     Int
  usuarioId      Int

  estimuloDiscriminativo     String?
  resposta                   String?
  estimuloReforcadorPositivo String?
  procedimentoEnsinoId       Int?

  subitems Json?

  createdAt DateTime?        @default(now())
  updatedAt DateTime?        @updatedAt
  vbmapp    VBMappAtividades @relation(fields: [vbmappId], references: [id])
  paciente  Paciente         @relation(fields: [pacienteId], references: [id])
  terapeuta Usuario?         @relation(fields: [usuarioId], references: [id])
}

model VBMappAtividades {
  id              Int     @id @default(autoincrement())
  nome            String  @db.Text // Para valores longos, usamos `Text`
  nivel           Int
  programaId      Int
  permiteSubitens Boolean @default(false)

